{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tom/tom-seeded-program-1.0.schema.json",
  "title": "TOM Seeded Compilation Profile 1.0 source document",
  "type": "object",
  "additionalProperties": false,
  "required": ["tomagi_version", "compilation_profile", "seed_genome", "root_definition", "budgets", "definitions"],
  "properties": {
    "$schema": {"type": "string"},
    "tomagi_version": {"const": "1.0.0"},
    "compilation_profile": {"const": "TOM-SEEDED-COMPILATION-1.0"},
    "title": {"type": "string", "minLength": 1},
    "seed_genome": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "grammar_id", "token_registry"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"const": 244},
        "sha256": {"const": "d1417a3136772c0cf3eddcd4962ce07d42cbf87616f7b5bae09fc652d9b807b5"},
        "grammar_id": {"const": "TOM-SEED-GRAMMAR-1.0"},
        "token_registry": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "root_definition": {"type": "string", "minLength": 1},
    "budgets": {"$ref": "#/$defs/budgets"},
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/definition"}
    }
  },
  "$defs": {
    "positiveInteger": {"type": "integer", "minimum": 1},
    "integerLiteral": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "pattern": "^[+-]?(0[xX][0-9a-fA-F]+|[0-9]+)$"}
      ]
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_definitions", "max_cells", "max_output_bytes", "max_sequence_items",
        "max_repeat", "max_expression_depth", "max_expression_nodes", "max_string_bytes"
      ],
      "properties": {
        "max_definitions": {"$ref": "#/$defs/positiveInteger"},
        "max_cells": {"$ref": "#/$defs/positiveInteger"},
        "max_output_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_sequence_items": {"$ref": "#/$defs/positiveInteger"},
        "max_repeat": {"$ref": "#/$defs/positiveInteger"},
        "max_expression_depth": {"$ref": "#/$defs/positiveInteger"},
        "max_expression_nodes": {"$ref": "#/$defs/positiveInteger"},
        "max_string_bytes": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_definitions": {"$ref": "#/$defs/positiveInteger"},
        "max_cells": {"$ref": "#/$defs/positiveInteger"},
        "max_output_bytes": {"$ref": "#/$defs/positiveInteger"},
        "max_sequence_items": {"$ref": "#/$defs/positiveInteger"},
        "max_repeat": {"$ref": "#/$defs/positiveInteger"},
        "max_expression_depth": {"$ref": "#/$defs/positiveInteger"},
        "max_expression_nodes": {"$ref": "#/$defs/positiveInteger"},
        "max_string_bytes": {"$ref": "#/$defs/positiveInteger"}
      },
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "required": [
        "id", "kind", "domain", "codomain", "dependencies", "phase", "order",
        "operation", "parameters", "limits", "provenance", "content_hash"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "pattern": "^(canonical-seed|seed-parse|literal-.+|initial-state|computed-hash|hash-guard|byte-emission|artifact-program|record-sequence|formal-evaluation|canonical-encoding)$"
        },
        "domain": {"enum": ["none", "bytes", "seed-record", "hash-pair", "state-graph-guard", "record-sequence", "formal-program-sequence", "record"]},
        "codomain": {"enum": ["bytes", "record", "sequence", "string", "bool", "i32", "u32", "state64", "cell_graph", "program"]},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "phase": {"enum": ["parse", "normalize", "resolve", "construct", "transform", "support", "compatibility", "guard", "event", "transition", "lineage"]},
        "order": {"type": "integer", "minimum": 0},
        "operation": {
          "type": "object",
          "required": ["op"],
          "properties": {
            "op": {"enum": ["seed.bytes", "seed.tokens", "literal", "state64.construct", "hash.sha256", "assert.equal", "emit.graph", "program.construct", "source.json", "sequence.construct", "formal.evaluate", "canonical.encode"]}
          },
          "additionalProperties": false
        },
        "parameters": {"type": "object"},
        "limits": {"$ref": "#/$defs/limits"},
        "provenance": {"type": "object", "minProperties": 1},
        "seed_tokens": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "seed.bytes"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "canonical-seed"},
              "domain": {"const": "none"},
              "codomain": {"const": "bytes"},
              "dependencies": {"maxItems": 0},
              "parameters": {"type": "object", "maxProperties": 0}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "seed.tokens"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "seed-parse"},
              "domain": {"const": "bytes"},
              "codomain": {"const": "record"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {"type": "object", "maxProperties": 0}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "literal"}}}}},
          "then": {
            "properties": {
              "kind": {"type": "string", "pattern": "^literal-.+"},
              "parameters": {
                "type": "object",
                "required": ["result_type", "value"],
                "properties": {
                  "result_type": {"enum": ["bytes", "string", "bool", "i32", "u32", "record"]},
                  "value": {}
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "state64.construct"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "initial-state"},
              "domain": {"const": "seed-record"},
              "codomain": {"const": "state64"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {
                "type": "object",
                "required": ["fields"],
                "properties": {
                  "fields": {
                    "type": "object",
                    "properties": {
                      "rho": {"$ref": "#/$defs/integerLiteral"},
                      "theta": {"$ref": "#/$defs/integerLiteral"},
                      "tick": {"$ref": "#/$defs/integerLiteral"},
                      "phi": {"$ref": "#/$defs/integerLiteral"},
                      "vrho": {"$ref": "#/$defs/integerLiteral"},
                      "vtheta": {"$ref": "#/$defs/integerLiteral"},
                      "vtick": {"$ref": "#/$defs/integerLiteral"},
                      "vphi": {"$ref": "#/$defs/integerLiteral"},
                      "orientation": {"$ref": "#/$defs/integerLiteral"},
                      "sheet": {"$ref": "#/$defs/integerLiteral"},
                      "branch": {"$ref": "#/$defs/integerLiteral"},
                      "cell": {"$ref": "#/$defs/integerLiteral"},
                      "lineage": {"$ref": "#/$defs/integerLiteral"},
                      "output": {"$ref": "#/$defs/integerLiteral"},
                      "residual": {"$ref": "#/$defs/integerLiteral"},
                      "status": {"$ref": "#/$defs/integerLiteral"}
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "hash.sha256"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "computed-hash"},
              "domain": {"const": "bytes"},
              "codomain": {"const": "string"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {
                "type": "object",
                "properties": {"prefix": {"type": "boolean"}},
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "assert.equal"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "hash-guard"},
              "domain": {"const": "hash-pair"},
              "codomain": {"const": "bool"},
              "dependencies": {"minItems": 2, "maxItems": 2},
              "parameters": {"type": "object", "maxProperties": 0}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "emit.graph"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "byte-emission"},
              "domain": {"const": "bytes"},
              "codomain": {"const": "cell_graph"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {
                "type": "object",
                "properties": {
                  "chunk_bytes": {"$ref": "#/$defs/integerLiteral"},
                  "byte_order": {"enum": ["little", "big"]},
                  "id_prefix": {"type": "string", "minLength": 1},
                  "key_base": {
                    "type": "object",
                    "properties": {
                      "rho": {"$ref": "#/$defs/integerLiteral"},
                      "theta": {"$ref": "#/$defs/integerLiteral"},
                      "tick": {"$ref": "#/$defs/integerLiteral"},
                      "phi": {"$ref": "#/$defs/integerLiteral"}
                    },
                    "additionalProperties": false
                  },
                  "key_field": {"enum": ["rho", "theta", "tick", "phi"]},
                  "aux_base": {"$ref": "#/$defs/integerLiteral"},
                  "halt_last": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "program.construct"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "artifact-program"},
              "domain": {"const": "state-graph-guard"},
              "codomain": {"const": "program"},
              "dependencies": {"minItems": 3, "maxItems": 3},
              "parameters": {
                "type": "object",
                "properties": {
                  "entry": {"type": "string", "minLength": 1},
                  "flags": {"$ref": "#/$defs/integerLiteral"},
                  "seed": {"$ref": "#/$defs/integerLiteral"},
                  "default_ticks": {"$ref": "#/$defs/integerLiteral"},
                  "emit_bytes": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "source.json"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "literal-json-source"},
              "domain": {"const": "seed-record"},
              "codomain": {"const": "record"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {
                "type": "object",
                "required": ["path", "bytes", "sha256", "canonical_newline", "verify_content_hash"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "bytes": {"type": "integer", "minimum": 0},
                  "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                  "canonical_newline": {"type": "boolean"},
                  "verify_content_hash": {"type": "boolean"}
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "sequence.construct"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "record-sequence"},
              "domain": {"const": "record-sequence"},
              "codomain": {"const": "sequence"},
              "dependencies": {"minItems": 1},
              "parameters": {"type": "object", "maxProperties": 0}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "formal.evaluate"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "formal-evaluation"},
              "domain": {"const": "formal-program-sequence"},
              "codomain": {"const": "record"},
              "dependencies": {"minItems": 2, "maxItems": 2},
              "parameters": {
                "type": "object",
                "required": ["input_name"],
                "properties": {"input_name": {"type": "string", "minLength": 1}},
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"properties": {"op": {"const": "canonical.encode"}}}}},
          "then": {
            "properties": {
              "kind": {"const": "canonical-encoding"},
              "domain": {"const": "record"},
              "codomain": {"const": "bytes"},
              "dependencies": {"minItems": 1, "maxItems": 1},
              "parameters": {
                "type": "object",
                "required": ["terminal_newline"],
                "properties": {"terminal_newline": {"type": "boolean"}},
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
