ad51-4ce4-4ffe-be50-6753c4f997ae","schemeUri":"https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords","subjectScheme":"NASA/GCMD Earth Science Keywords"}],"contributors":[{"name":"Deng, Zhiguo","nameType":"Personal","givenName":"Zhiguo","familyName":"Deng","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ProjectLeader","nameIdentifiers":[{"schemeUri":"https://orcid.org/","nameIdentifier":"https://orcid.org/0000-0002-0452-9185","nameIdentifierScheme":"ORCID"}]},{"name":"Fritsche, Mathias","nameType":"Personal","givenName":"Mathias","familyName":"Fritsche","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ProjectMember","nameIdentifiers":[]},{"name":"Fritsche, Mathias","nameType":"Personal","givenName":"Mathias","familyName":"Fritsche","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ResearchGroup","nameIdentifiers":[]},{"name":"Nischan, Thomas","nameType":"Personal","givenName":"Thomas","familyName":"Nischan","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ResearchGroup","nameIdentifiers":[{"schemeUri":"https://orcid.org/","nameIdentifier":"https://orcid.org/0000-0001-5607-2298","nameIdentifierScheme":"ORCID"}]},{"name":"Bradke, Markus","nameType":"Personal","givenName":"Markus","familyName":"Bradke","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ResearchGroup","nameIdentifiers":[{"schemeUri":"https://orcid.org/","nameIdentifier":"https://orcid.org/0000-0003-1084-2909","nameIdentifierScheme":"ORCID"}]},{"name":"Deng, Zhiguo","nameType":"Personal","givenName":"Zhiguo","familyName":"Deng","affiliation":["GFZ German Research Center for Geosciences, Potsdam, Germany"],"contributorType":"ContactPerson","nameIdentifiers":[{"schemeUri":"https://orcid.org/","nameIdentifier":"https://orcid.org/0000-0002-0452-9185","nameIdentifierScheme":"ORCID"}]}],"dates":[{"date":"2015-05-27","dateType":"Collected"},{"date":"2015-05-27","dateType":"Created"},{"date":"2016","dateType":"Issued"},{"date":"2015-05-27","dateType":"Valid"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"IsDocumentedBy","relatedIdentifier":"https://igscb.jpl.nasa.gov/igscb/data/format/erp.txt","relatedIdentifierType":"URL"},{"relationType":"IsDocumentedBy","relatedIdentifier":"https://files.igs.org/pub/data/format/sp3c.txt","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"lang":"en","rights":"Attribution-NonCommercial 4.0 International (CC BY-NC 4.0)"}],"descriptions":[{"description":"The German Research Center for Geosciences (GFZ) is providing ultra rapid multi-GNSS orbit-, clock- and EOP-product series (EOP = Earth Orientation Parameters). \u003cbr\u003e\u003cbr\u003eThe Orbit/Clock product covers the following Global Navaigation Satellite Systems (GNSS) \u003cbr\u003e - GAL (Galileo) / Europe \u003cbr\u003e - GPS (GPS) / USA \u003cbr\u003e - GLO (Glonass) / Russian Federation \u003cbr\u003e - BDS (Beidou) / PR China \u003cbr\u003e - QZS (QZSS) / Japan \u003cbr\u003eAll products are estimated using the latest version of GFZ's automated EPOS-8 GNSS \u003cbr\u003eprocessing environment and using global hourly RINEX observation data of the \u003cbr\u003eInternational GNSS Service (IGS). \u003cbr\u003e\u003cbr\u003e The orbit/clock product is provided: \u003cbr\u003e - in the SP3-c data format, \u003cbr\u003e - every 3 hours with a nominal latency of 2 hours after the last observation, \u003cbr\u003e - with a 48 hour sliding window orbit duration \u003cbr\u003e (1) the first 24 hours are estimated based on real GNSS RINEX observation data, \u003cbr\u003e (2) the second 24 hours consist of an orbit/clock prediction, \u003cbr\u003e - the orbit positions epoch interval is of 15 minutes. \u003cbr\u003e\u003cbr\u003e The EOP product is provided: \u003cbr\u003e - in the IGS ERP data format, \u003cbr\u003e - every 3 hours with a nominal latency of 2 hours after last observation, \u003cbr\u003e - with one estimated 24 hour EOP record based on real GNSS RINEX observation data, \u003cbr\u003e - with one predicted 24 hour EOP record. \u003cbr\u003e\u003cbr\u003eFor recent (latest) products used for routine applications a registration via mgnss@gfz-potsdam.de is needed \u003cbr\u003eto get special access. Products with an age older than 2 days are available without restrictions. \u003cbr\u003e\u003cbr\u003eFor the used data formats see Kouba and Mierault (2010, https://igscb.jpl.nasa.gov/igscb/data/format/erp.txt) for the description of the EOP Product Series and Hilla (2010, https://igscb.jpl.nasa.gov/igscb/data/format/sp3c.txt) for the description of the Orbit-/ Clock format SP3-c). The time series are provided in weekly folders, beginning with 27 May 2015 (GPS Week 1846).","descriptionType":"Abstract"}],"geoLocations":[{"geoLocationBox":{"eastBoundLongitude":180,"northBoundLatitude":90,"southBoundLatitude":-90,"westBoundLongitude":-180}}],"fundingReferences":[],"xml":"","url":"https://dataservices.gfz.de/10.5880/gfz.1.1.2016.003/multi-gnss-ultra-rapid-orbit-clock-amp-eop","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":6,"citationsOverTime":[{"year":"2022","total":1},{"year":"2024","total":3},{"year":"2025","total":1},{"year":"2026","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2016-10-11T07:19:21.000Z","registered":"2016-10-11T07:19:23.000Z","published":"2016","updated":"2026-09-01T12:43:22.000Z"},"relationships":{"client":{"data":{"id":"tib.gfz","type":"clients"}},"provider":{"data":{"id":"gfz","type":"providers"}},"media":{"data":{"id":"10.5880/gfz.1.1.2016.003","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1186/s43020-022-00075-1","type":"dois"},{"id":"10.1016/j.asr.2024.03.015","type":"dois"},{"id":"10.3390/rs11243024","type":"dois"},{"id":"10.3390/rs13193905","type":"dois"},{"id":"10.1007/s10291-025-01890-0","type":"dois"},{"id":"10.1007/s00190-026-02055-8","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}